# ── HikCentral OpenAPI (Artemis) ─────────────────────────────
# Se generan en HikCentral > Configuracion del sistema > Cuenta OpenAPI
HIKCENTRAL_HOST=https://IP_O_DOMINIO_DEL_SERVIDOR:PUERTO
HIKCENTRAL_APP_KEY=
HIKCENTRAL_APP_SECRET=

# ── Programacion ──────────────────────────────────────────────
# Formato cron: minuto hora dia-mes mes dia-semana
# Ejemplo: correr a las 08:00 del dia 21 de cada mes
CRON_SCHEDULE=0 8 21 * *
TIMEZONE=America/Argentina/Buenos_Aires

# ── Envio de mail ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
MAIL_TO=vos@tucorreo.com,otro@tucorreo.com
MAIL_FROM="FicheroHik <tu_correo@gmail.com>"

# ── Twilio WhatsApp (Fase 3) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Servidor ──────────────────────────────────────────────────
PORT=3000

# -- Asistente IA del bot de WhatsApp (interpretacion de mensajes) ---
# Se genera en console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Numero de WhatsApp del administrador (el que aprueba/rechaza correcciones)
ADMIN_WHATSAPP_NUMBER=+549XXXXXXXXXX

# Clave para proteger los endpoints /admin/* (header x-admin-key)
ADMIN_API_KEY=

# -- Monitoreo en tiempo real de fichadas -----------------------
CRON_POLL_FICHADAS=*/2 * * * *
CRON_RECORDATORIOS=0 * * * *
CONFIRMACION_DELAY_MIN=2
RECORDATORIO_UMBRAL_MANTENIMIENTO_HORAS=10
RECORDATORIO_GRACIA_CONSERJERIA_MIN=30
RECORDATORIO_CORTE_HORA=0
